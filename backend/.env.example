# ---- Django ----
DJANGO_SECRET_KEY=please-change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_SQLITE_PATH=./data/db.sqlite3

# ---- CORS ----
# 本地开发默认放行所有来源；生产请设置为 False 并配置白名单
CORS_ALLOW_ALL=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# ---- 限流（防滥用）----
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=100

# ---- 上游调用 ----
UPSTREAM_TIMEOUT_SECONDS=45
UPSTREAM_IMAGE_TIMEOUT_SECONDS=90
UPSTREAM_MAX_RETRIES=1
LOG_GENERATION=True
MAX_INPUT_CHARS=8000
CONTENT_BLOCKLIST=制作炸弹,制毒,儿童色情,恐怖袭击,自制枪支

# ---- 模型白名单（JSON 单行；不配置则自动进入演示模式）----
# 示例（OpenAI 兼容接口）：
# AI_MODELS_JSON=[{"id":"deepseek-chat","name":"DeepSeek Chat","provider":"openai","type":"text","upstream_model":"deepseek-chat","base_url":"https://api.deepseek.com/v1","api_key_env":"DEEPSEEK_API_KEY"},{"id":"gpt-image-1","name":"GPT Image","provider":"openai","type":"image","upstream_model":"gpt-image-1","base_url":"https://api.openai.com/v1","api_key_env":"OPENAI_API_KEY"}]
AI_MODELS_JSON=

# 第三方密钥（仅服务端读取，前端永远拿不到）
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# ---- 单容器部署 ----
# 指向前端构建产物目录；Dockerfile 中已自动复制到 /app/frontend_dist
FRONTEND_DIST=./frontend_dist
